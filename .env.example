DEEPSEEK_API_KEY=
# --- Первый администратор (создаётся при первом старте). ОБЯЗАТЕЛЬНО смените пароль.
ADMIN_EMAIL=admin@aispace.local
ADMIN_PASSWORD=admin123456

# --- Регистрация только с этих доменов (через запятую). Пусто — любой домен.
ALLOWED_EMAIL_DOMAINS=aispace.local

# --- Офис
OFFICE_TZ=Asia/Almaty
# WORK_DAY_START=08:00
# WORK_DAY_END=20:00
# MAX_BOOKING_MINUTES=240
# BOOKING_HORIZON_DAYS=60

# --- Создать демо-комнаты при пустой базе
SEED_DEMO_ROOMS=true

# --- PostgreSQL (контейнер db). DATABASE_URL для приложения собирается из этих значений.
POSTGRES_DB=aispace
POSTGRES_USER=aispace
POSTGRES_PASSWORD=aispace

# --- Порт на хосте
APP_PORT=8000

# --- За HTTPS-прокси включите secure-cookie
COOKIE_SECURE=false
        